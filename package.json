{
  "name": "onhand",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Every file converter on one page. Nothing is ever uploaded \u2014 including video.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check .",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:all": "ONHAND_BROWSER=chromium vitest run --config vitest.browser.config.ts && ONHAND_BROWSER=firefox vitest run --config vitest.browser.config.ts && ONHAND_BROWSER=webkit vitest run --config vitest.browser.config.ts",
    "test:all": "pnpm test && pnpm test:browser",
    "sync:ffmpeg": "node scripts/sync-ffmpeg-core.mjs",
    "predev": "node scripts/sync-ffmpeg-core.mjs",
    "prebuild": "node scripts/sync-ffmpeg-core.mjs",
    "fixtures:av": "python3 fixtures/generate_av.py",
    "serve:dist": "node scripts/serve-dist.mjs",
    "postbuild": "node scripts/build-sw.mjs",
    "og": "node scripts/make-og.mjs",
    "pretest:browser": "node scripts/sync-ffmpeg-core.mjs",
    "pretest:browser:all": "node scripts/sync-ffmpeg-core.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "airplane": "node scripts/make-airplane-gif.mjs",
    "audit:pages": "node scripts/audit-pages.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.0",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "astro": "^5.16.0",
    "comlink": "^4.4.2",
    "fflate": "^0.8.3",
    "libheif-js": "^1.19.8",
    "mediabunny": "^1.52.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@ffmpeg/core": "^0.12.10",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/browser": "^3.2.7",
    "axe-core": "^4.12.1",
    "playwright": "^1.62.1",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
