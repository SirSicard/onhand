---
import Base from "../layouts/Base.astro";
import Converter from "../components/Converter";
import EnvironmentReport from "../components/EnvironmentReport";
import { PAIRS, slugFor, titleFor } from "../lib/pairs";
import { CONVERSION_COUNT, FORMATS } from "../engine/formats";

// The most-wanted conversions, in the order pairs.ts ranks them. Generated
// rather than written out, so this cannot advertise a pair that does not exist.
const popular = PAIRS.slice(0, 12);

const counts = { formats: Object.keys(FORMATS).length, pairs: CONVERSION_COUNT };
---

<Base
  title="Onhand — convert any file, nothing uploaded"
  description="Free file converter that runs entirely in your browser. Images, audio and video — including video — converted on your own device. Nothing is ever uploaded."
>
  <main class="mx-auto flex min-h-dvh max-w-3xl flex-col gap-10 px-6 py-16">
    <header class="text-center">
      <h1 class="text-display">Onhand</h1>
      <p class="mt-4 text-lg text-glass-600 dark:text-glass-400">
        Every file converter on one page.<br />
        Nothing is ever uploaded — <em>including video</em>.
      </p>
    </header>

    {
      /*
      When the service worker cannot reach the network it falls back to this
      page for ANY navigation, including a pair page the visitor has never
      opened. The converter still works, which is the point — but the address
      bar says /heic-to-jpg/ while this renders, and silently showing the wrong
      page is worse than saying so.
    */
    }
    <p
      id="offline-fallback"
      hidden
      class="rounded-lg border border-glass-200 px-3 py-2 text-sm text-glass-600 dark:border-glass-800 dark:text-glass-400"
      role="status"
    >
      You're offline and haven't opened that page before, so this is the main converter instead. It
      works exactly the same — pick your format below.
    </p>

    <Converter client:load />

    <section>
      <h2
        class="text-center text-xs font-semibold tracking-[0.08em] text-glass-600 uppercase dark:text-glass-400"
      >
        Common conversions
      </h2>
      <ul class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3">
        {
          popular.map((pair) => (
            <li>
              <a
                href={`/${slugFor(pair)}/`}
                class="block rounded-xl border border-glass-200 bg-glass-100 px-3 py-2.5 text-center text-sm font-medium transition-colors duration-150 ease-[var(--ease-out-quart)] hover:border-copper-400 hover:text-copper-700 motion-reduce:transition-none dark:border-glass-800 dark:bg-glass-900 dark:hover:text-copper-400"
              >
                {titleFor(pair)}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 text-center text-sm text-glass-600 dark:text-glass-400">
        <a href="/formats/" class="underline underline-offset-2 hover:text-copper-500">
          All {counts.formats} formats and {counts.pairs} conversions
        </a>
      </p>
    </section>

    <details
      class="group rounded-2xl border border-glass-200 bg-glass-100 px-4 py-3 dark:border-glass-800 dark:bg-glass-900"
    >
      <summary
        class="flex cursor-pointer list-none items-center gap-2 text-sm font-medium text-glass-600 transition-colors hover:text-glass-900 motion-reduce:transition-none dark:text-glass-400 dark:hover:text-glass-100"
      >
        <svg
          viewBox="0 0 12 12"
          aria-hidden="true"
          class="h-3 w-3 transition-transform duration-200 ease-[var(--ease-out-quart)] group-open:rotate-90 motion-reduce:transition-none"
        >
          <path
            d="M4 2l4 4-4 4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        What this browser can do
      </summary>
      <div class="mt-4 border-t border-glass-200 pt-4 dark:border-glass-800">
        <EnvironmentReport client:visible />
      </div>
    </details>

    <footer class="text-center text-sm text-glass-600 dark:text-glass-400">
      <p>
        <a href="/tools/" class="hover:text-copper-500">Tools</a> ·
        <a href="/formats/" class="hover:text-copper-500">All formats</a> ·
        <a href="/why/" class="hover:text-copper-500">Why this exists</a> ·
        <a href="https://github.com/SirSicard/onhand" class="hover:text-copper-500">Source</a>
      </p>
      <p class="mt-2">
        Images, PDF, audio and video.<br />
        MIT licensed. No accounts, no telemetry, no ads.
      </p>
    </footer>
  </main>

  <script>
    // Runs only in the fallback case: this document served at some other URL.
    if (location.pathname !== "/" && location.pathname !== "/index.html") {
      document.getElementById("offline-fallback")?.removeAttribute("hidden");
    }
  </script>
</Base>
